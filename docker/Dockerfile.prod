# Image de production : build Vite, précompression Brotli/gzip, puis Caddy (HTTPS automatique, HTTP/3).
# Usage : SITE_URL=https://mon-domaine.fr SITE_ADDRESS=mon-domaine.fr AUTO_HTTPS=on make prod
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG SITE_URL=http://localhost:8080
ENV SITE_URL=$SITE_URL
RUN npm run build && node scripts/precompress.mjs dist

FROM caddy:2-alpine
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80 443
HEALTHCHECK CMD wget -qO- http://localhost/ >/dev/null || exit 1
