{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, // Node exécute server/*.ts tel quel : pas de propriétés de paramètre ni d'enum
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "server/**/*.ts"]
}
